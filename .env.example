# Sentinel Nexus configuration. Copy to .env and fill in.

# --- RTSP credentials -------------------------------------------------------
# The grid began requiring Basic auth on 2026-09-02:
#   RTSP/1.0 401 Unauthorized
#   WWW-Authenticate: Basic realm="ipcam"
# Without these, every camera fails to open. They are injected at connection
# time and never written into cameras.json or the database.
SENTINEL_RTSP_USER=
SENTINEL_RTSP_PASSWORD=

# --- Endpoints --------------------------------------------------------------
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554

# --- Security ---------------------------------------------------------------
# MUST be changed before any real deployment. The app warns while this is unset.
JWT_SECRET=dev-only-change-in-production

# --- Hardware profile: low | balanced | high --------------------------------
SENTINEL_PROFILE=balanced

# --- Plate layout: IN (Indian registrations) | GENERIC ----------------------
SENTINEL_PLATE_REGION=IN

# --- Detector ---------------------------------------------------------------
# "auto" picks the YOLO11 variant for SENTINEL_PROFILE and degrades to the next
# lighter one, then to YOLOv4-tiny, if weights are missing. Pin a model with
# yolo11n | yolo11s | yolo11m | yolo11l, or "yolov4-tiny" to force the old path.
SENTINEL_DETECTOR=auto
# ONNX intra-op threads. 0 takes all cores but one, leaving room for the decoder.
SENTINEL_DETECTOR_THREADS=0
SENTINEL_DETECTOR_CONF=0.25

# Learned licence-plate localiser. Off by default: it measured ZERO detections
# on this grid's night footage for an extra 39 ms per crop. Turn it on for a
# dedicated ANPR camera or daylight footage. See pipeline/plate_detect.py.
SENTINEL_PLATE_DETECTOR=0

# --- Map --------------------------------------------------------------------
# Raster basemap tiles, e.g. https://tiles.internal.gov/dark/{z}/{x}/{y}.png
# Empty is the default and is deliberate -- every free dark basemap now
# watermarks or blocks anonymous use, so with no URL the map is drawn from the
# OpenStreetMap layers this platform fetches and caches itself.
SENTINEL_BASEMAP_URL=
SENTINEL_BASEMAP_ATTRIBUTION=
