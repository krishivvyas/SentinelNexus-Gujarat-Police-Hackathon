# Sentinel Nexus configuration. Copy to .env and fill in.

# --- RTSP credentials -------------------------------------------------------
# The grid began requiring Basic auth on 2026-09-02:
#   RTSP/1.0 401 Unauthorized
#   WWW-Authenticate: Basic realm="ipcam"
# Without these, every camera fails to open. They are injected at connection
# time and never written into cameras.json or the database.
SENTINEL_RTSP_USER=
SENTINEL_RTSP_PASSWORD=

# --- Endpoints --------------------------------------------------------------
SENTINEL_RTSP_HOST=103.250.160.189
SENTINEL_RTSP_PORT=8554

# --- Security ---------------------------------------------------------------
# MUST be changed before any real deployment. The app warns while this is unset.
JWT_SECRET=dev-only-change-in-production

# --- Hardware profile: low | balanced | high --------------------------------
SENTINEL_PROFILE=balanced

# --- Plate layout: IN (Indian registrations) | GENERIC ----------------------
SENTINEL_PLATE_REGION=IN
